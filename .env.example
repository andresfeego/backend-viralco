PORT=4000
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CHARSET=utf8mb4

R2_BUCKET_PATH=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_REGION=
R2_ACCOUNT_ID=

# Comprobantes: bucket privado separado, sin r2.dev ni dominios publicos.
# Credenciales S3 limitadas a Object Read & Write para este bucket.
BILLING_R2_BUCKET_NAME=
BILLING_R2_ACCOUNT_ID=
BILLING_R2_ACCESS_KEY_ID=
BILLING_R2_SECRET_ACCESS_KEY=
BILLING_R2_BUCKET_REGION=auto
OFFLINE_SIGNING_KEY_FILE=.secrets/offline-ed25519.pem

# Opcional. Solo se usa si un medio del manifiesto global falta en R2.
GLOBAL_LIBRARY_ASSET_ROOT=
GLOBAL_LIBRARY_CREATED_BY=

ACCESS_TOKEN_SECRET=
REFRESH_TOKEN_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

SUPER_ADMIN_CONFIRM_SECRET=
SUPER_ADMIN_CONFIRM_PASSWORD=
SUPER_ADMIN_CONFIRM_TTL=10m

PASSWORD_RESET_TTL_MINUTES=30

BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=
BOOTSTRAP_SUPER_ADMIN_NAME=
TECHNICAL_LOG_DIRECTORY=
PUBLIC_WEB_URL=
